# ===== Servidor =====
PORT=3000
# URL publica onde a API vai rodar (usada como "resource" na listagem do Bazaar)
PUBLIC_BASE_URL=http://localhost:3000

# ===== Pagamentos x402 =====
# "base-sepolia" (testnet, para desenvolver) ou "base" (mainnet, para receber de verdade)
NETWORK=base-sepolia
# Endereco EVM que RECEBE os pagamentos em USDC. A chave privada NUNCA entra no servidor.
# Gere uma carteira com: npm run wallet
PAY_TO=0x0000000000000000000000000000000000000000

# Chaves do CDP Portal (https://portal.cdp.coinbase.com) - obrigatorias APENAS na mainnet.
# Na testnet o facilitador publico https://x402.org/facilitator e usado automaticamente.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ===== Dados on-chain =====
# RPCs da Base mainnet (gratuitos), separados por virgula - fallback automatico.
# Pode acrescentar Alchemy/Infura free tier para mais velocidade/confiabilidade.
BASE_RPC_URL=https://base-rpc.publicnode.com,https://base.drpc.org,https://mainnet.base.org

# Opcional. O plano gratuito do Etherscan NAO cobre a Base; se a chave falhar,
# a API cai no RPC publico sozinha (janela de poucas horas, cache incremental).
ETHERSCAN_API_KEY=
# Maximo de blocos varridos por requisicao paga (200000 blocos ~ 4,6 dias na Base).
# A cobertura e incremental: chamadas repetidas estendem a janela (fica em cache no SQLite).
SCAN_MAX_BLOCKS_PER_REQUEST=200000

# ===== Banco de dados =====
DB_PATH=./data/x402rep.db

# ===== Snapshot do Bazaar =====
# Limite de itens por pagina da API de descoberta (max aceito pela API hoje: 100)
BAZAAR_PAGE_LIMIT=100
# 0 = sem limite (baixa o catalogo inteiro, ~33 mil itens)
BAZAAR_MAX_ITEMS=0

# ===== Teste como comprador (scripts/test-buyer.ts) =====
# Chave privada de uma carteira de TESTE com USDC na Base Sepolia (faucet: https://faucet.circle.com)
# NUNCA use a carteira que recebe os pagamentos aqui.
BUYER_PRIVATE_KEY=
# URL do servidor a testar
BUYER_TARGET_URL=http://localhost:3000
